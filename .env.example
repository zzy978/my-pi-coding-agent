# 复制为应用安装目录中的 .env；本地开发时为 D:\Agent\.env。
# .env 不提交 Git；模板中不要填写真实密钥。
# 系统环境变量优先于本文件；留空表示使用默认值或已有 Pi 配置。
# 可通过系统环境变量 PICODE_ENV_FILE 指定另一个配置文件的绝对路径。

# 必须使用 Pi 已知或 agent/models.json 已注册的 provider 和模型 ID。
# provider 留空时继续使用 Pi 原有模型选择与认证。
PICODE_MODEL_PROVIDER=
PICODE_MODEL_ID=
PICODE_MODEL_API_KEY=
# HTTP(S) API 根地址，如 https://api.example.com/v1；不含密钥或查询参数。
PICODE_MODEL_BASE_URL=

# 单次模型请求墙钟上限（毫秒，包含该请求内部重试）。
PICODE_MODEL_REQUEST_TIMEOUT_MS=120000
# 单次输出上限，包含共享输出预算的思考 token；仍受模型能力和剩余上下文约束。
PICODE_MODEL_MAX_OUTPUT_TOKENS=16384
# 一轮代理任务上限（含多次模型请求和工具执行）；0 表示不设置额外总时限。
# 配对实验仍有自己的总时限，两者同时配置时采用更短的时限。
PICODE_MODEL_TASK_TIMEOUT_MS=0

# 经验提炼单独使用以下上限，并始终使用来源记录中的 provider/model。
PICODE_SYNTHESIS_TIMEOUT_MS=120000
PICODE_SYNTHESIS_MAX_OUTPUT_TOKENS=16000
